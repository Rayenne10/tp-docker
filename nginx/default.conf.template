# DNS embarque Docker ; actualiser les adresses apres scale/recreation.
resolver 127.0.0.11 valid=5s ipv6=off;
upstream counter_backend {
    zone counter_backend 64k;
    server web:${APP_PORT} resolve;
}
server {
    listen 8080;
    server_name _;
    location / {
        proxy_pass http://counter_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        # Eviter de rejouer une visite sur un autre backend en cas d'erreur.
        proxy_next_upstream off;
    }
}
